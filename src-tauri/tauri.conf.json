{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "password-store-gui",
  "version": "0.1.0",
  "identifier": "dev.passwordstoregui.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Password Store",
        "width": 1100,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; form-action 'none'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "gnupg/": "gnupg/"
    },
    "linux": {
      "deb": {
        "depends": ["gnupg"]
      },
      "rpm": {
        "depends": ["gnupg2"]
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
